{
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "declaration": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "isolatedModules": true
  },
  "include": [ "**/*.ts", "**/*.tsx" ]
}
