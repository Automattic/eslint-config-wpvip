{
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "isolatedModules": true,
    "types": [ "node", "jest" ]
  },
  "include": [ "**/*.ts", "**/*.tsx" ]
}
